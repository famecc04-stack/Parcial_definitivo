@startuml SERF_FinanCorp_Casos_de_Uso
skinparam monochrome false
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam packageStyle rectangle

title FinanCorp S.A. - Casos de Uso del Sistema SERF

actor "Administrador Financiero" as Admin #1A365D
actor "Operador Shenzhen (China)" as Importador #0D9488
actor "Vendedor / Cajero (Filial)" as Vendedor #2B6CB0
actor "Auditoras Financieras\n(Cadillo / Orellana)" as Auditoras #BE185D

rectangle "Sistema SERF (FinanCorp S.A.)" {
    ' Módulo Admin
    usecase "UC01: Consultar Tasas Oficiales" as UC01
    usecase "UC02: Actualizar Tasas Globales\n<<Singleton>>" as UC02
    usecase "UC03: Gestionar Filiales Activas" as UC03

    ' Módulo 1: Shenzhen
    usecase "UC04: Registrar Lote Importado" as UC04
    usecase "UC05: Validar Costos y Stock\n<<Defensivo >= 0>>" as UC05
    usecase "UC06: Consultar Catálogo Shenzhen" as UC06

    ' Módulo 2: Ventas
    usecase "UC07: Emitir Venta en Filial (Local)" as UC07
    usecase "UC08: Control Atómico de Stock" as UC08
    usecase "UC09: Convertir a Moneda Base EUR" as UC09

    ' Módulo 3: Reportes
    usecase "UC10: Seleccionar Plantilla Base\n<<Prototype>>" as UC10
    usecase "UC11: Generar Reporte Consolidado\n<<Facade + Builder>>" as UC11
    usecase "UC12: Ensamblar Secciones Jerárquicas\n<<Composite>>" as UC12
    usecase "UC13: Aplicar Marca 'CONFIDENCIAL'\n<<Decorator>>" as UC13
    usecase "UC14: Aplicar Firma Digital Auditoras\n<<Decorator>>" as UC14
}

' Asociaciones Actores
Admin --> UC01
Admin --> UC02
Admin --> UC03

Importador --> UC04
Importador --> UC06

Vendedor --> UC07

Auditoras --> UC10
Auditoras --> UC11

' Includes & Extends
UC04 ..> UC05 : <<include>>
UC07 ..> UC08 : <<include>>
UC07 ..> UC09 : <<include>>

UC11 ..> UC10 : <<include>>
UC11 ..> UC12 : <<include>>
UC13 ..> UC11 : <<extend>>
UC14 ..> UC11 : <<extend>>

@enduml
